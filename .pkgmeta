# BigWigs packager: the zip is the addon folder "WandererChat", the changelog of the version is CHANGELOG.md
# (written at each release from the full changelog).
package-as: WandererChat

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

ignore:
  - README.md

# Shown on CurseForge: Wanderer Chat needs Wanderer.
required-dependencies:
  - wanderer
